from marks import calculate_result


def test_total_marks():
    marks = [99, 98, 95, 15, 40]
    total, percentage, grade = calculate_result(marks)
    assert total == 347


def test_percentage():
    marks = [99, 98, 95, 15, 40]
    total, percentage, grade = calculate_result(marks)
    assert percentage == 69.4


def test_grade():
    marks = [99, 98, 95, 15, 40]
    total, percentage, grade = calculate_result(marks)
    assert grade == "C"
